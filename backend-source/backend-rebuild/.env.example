# PetCTT MVP Backend 환경변수
# 사용법: .env.example 파일을 .env로 복사한 후 실제 값 입력

# === 서버 설정 ===
NODE_ENV=development
PORT=3080

# === 데이터베이스 설정 ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=petctt_mvp
DB_USER=petctt_user
DB_PASSWORD=your-secure-password-here

# === JWT 인증 설정 ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# === 선택 사항 (MVP 이후) ===
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
# S3_BUCKET_NAME=

# === 개발 전용 ===
# DB 자동 동기화 (프로덕션에서는 false)
DB_SYNC=false
DB_FORCE_SYNC=false
