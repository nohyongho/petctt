                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coupon/nearby?lat=37.5012345&lng=127.0398765&radius=5000",
              "host": ["{{base_url}}"],
              "path": ["api", "coupon", "nearby"],
              "query": [
                {
                  "key": "lat",
                  "value": "37.5012345"
                },
                {
                  "key": "lng",
                  "value": "127.0398765"
                },
                {
                  "key": "radius",
                  "value": "5000"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.2 쿠폰 발행 (관리자)",
