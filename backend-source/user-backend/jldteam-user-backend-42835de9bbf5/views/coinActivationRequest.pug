extends layout

block content
  div.centering
    div.row
        div.col-md-12
            img(src='/images/logo.png' width='130px').center
        div.col-md-12
            h6
                strong Hi,
            p You have been invited to join Coin Hunter account by demo name
            hr.hr3
        div.col-md-12
            h6
                strong About COIN HUNTER
            p “Coin Hunter Platform” is the modern-day treasure hunt using 3D and AR technology. Simple, Fun to use & Rewarding game app in mobile gaming. Tyslin Foundation invented the latest forms of blockchain online gaming platform “Coin Hunter” app provides a safe environment that allows users to find, collect, and trade Digital Assets in Augmented Reality interface.      
            h6
                strong Download from Playstore
            a(href='https://play.google.com/store/apps/details?id=com.jld.android.coinhunter')
                img(src='images/download.png' width='130px')
            hr.hr3
    div.row
        div.col-md-12
            p.text-center.margin_m 
                strong Coin Humter Team
            p.text-center.margin_m https://ecoinhunter.com
            p.text-center Copyright © 2019. All Rights Reserved
        div.col-md-12.flex
            a(href='https://www.facebook.com/ecoinhunter/')
                img(src='images/facebook.png' width='30px')
            a(href='https://twitter.com/tyslin_1')
                img(src='images/twitter.png' width='30px').ml-2